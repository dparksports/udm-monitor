<Window x:Class="UdmMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UDM Monitor"
        Height="560" Width="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <ListView x:Name="Events" Grid.Row="1" FontFamily="Consolas">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding Time}"/>
                    <GridViewColumn Header="Source" Width="110" DisplayMemberBinding="{Binding Source}"/>
                    <GridViewColumn Header="Subject" Width="180" DisplayMemberBinding="{Binding Subject}"/>
                    <GridViewColumn Header="Message" Width="400" DisplayMemberBinding="{Binding Message}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" FontStyle="Italic" Foreground="Gray"
                   Text="Closing the window hides it to the tray — monitoring keeps running. High-severity events raise Windows toasts."/>
    </Grid>
</Window>
